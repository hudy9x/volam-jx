# Server settings. Copy to apps/server/.env (not in git):  cp apps/server/.env.example apps/server/.env
# Colyseus loads apps/server/.env.development, or if that file does not exist apps/server/.env (only the first one found),
# when the server starts. Variables already set in the shell win (e.g. PORT=2568 npm run dev -w @vltk/server).
# Every value below is the default the code uses when the variable is missing.

# Port of the game server (WebSocket + HTTP API). The client connects to :2567 unless ?server=<url> is given.
PORT=2567

# Account database (users, characters). Relative paths start at apps/server. Delete the file to reset all accounts.
DB_PATH=data/db.json

# Map grids (nav.json per map) written by gen:maps, and monster spawn files (gen:spawns / the dev tool on the big map).
# Unset = apps/client/public/assets/maps and packages/shared/spawns (found from the source files, wherever you start
# the server). A value set here is relative to the folder the server is started from (apps/server with npm run dev).
# MAPS_DIR=../client/public/assets/maps
# SPAWNS_DIR=../../packages/shared/spawns

# Secret that signs login tokens. When empty the server creates one and keeps it in apps/server/data/secret.
# Set it on a real server; never commit it.
# AUTH_SECRET=

# Dev tools (src/env.ts devTools): spawn editor API, +levels / +money / skill levels orders, the gold shop. 0 = off (do this on a public server).
DEV_TOOLS=1

# Print tick timings (any value turns it on).
# PERF=1
